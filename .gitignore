*.swo

# Operating-system files
.DS_Store
.AppleDouble
Thumbs.db
Desktop.ini

# CalcGPT generated data. Canonical datasets directly under datasets/ are
# intentionally tracked; only explicitly generated/scratch locations are ignored.
datasets/generated/
datasets/scratch/
datasets/*.generated.txt

# Models, checkpoints, experiment output, and logs never belong in Git.
models/*
!models/.gitkeep
artifacts/
checkpoints/
outputs/
results/
runs/
logs/
*.pt
*.pth
*.safetensors
optimizer.pt
scheduler.pt
training_args.bin
trainer_state.json
evaluation_results*.json

# Temporary and backup files
*.bak
*.orig
*.rej
*.tmp
*~
